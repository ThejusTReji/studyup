<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Game Home - Advanced Blue</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1/dist/phosphor.js"></script>
    <style>
        /* Custom styles for background and font */
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #1e3a8a, #065f46); /* Deeper, more engaging gradient */
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden; /* Prevent scrollbar from background effects */
            position: relative; /* For absolute positioning of background elements */
            animation: gradientShift 20s ease infinite alternate; /* Slower, more subtle background animation */
        }

        /* Subtle background pattern/texture */
        .background-pattern {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(circle at 100% 150%, rgba(30, 58, 138, 0.4) 0%, transparent 50%),
                               radial-gradient(circle at 0% -50%, rgba(6, 95, 70, 0.4) 0%, transparent 50%);
            opacity: 0.6;
            z-index: -1;
            animation: patternPan 40s linear infinite alternate; /* Slower animation for background pattern */
        }

        @keyframes patternPan {
            0% { background-position: 0% 0%; }
            100% { background-position: 100% 100%; }
        }

        /* Blob animations */
        @keyframes blob {
            0% { transform: translate(0, 0) scale(1); border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
            25% { transform: translate(40px, -60px) scale(1.1); border-radius: 70% 30% 70% 30% / 30% 70% 30% 70%; }
            50% { transform: translate(-30px, 30px) scale(0.9); border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%; }
            75% { transform: translate(50px, -20px) scale(1.05); border-radius: 30% 70% 50% 50% / 50% 50% 70% 30%; }
            100% { transform: translate(0, 0) scale(1); border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
        }

        .animate-blob {
            animation: blob 15s infinite cubic-bezier(0.68, -0.55, 0.27, 1.55); /* Longer, more complex animation */
        }

        .animation-delay-1000 { animation-delay: 1s; }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-3000 { animation-delay: 3s; }
        .animation-delay-4000 { animation-delay: 4s; }
        .animation-delay-5000 { animation-delay: 5s; }
        .animation-delay-6000 { animation-delay: 6s; }

        /* Keyframe for text animation */
        @keyframes fadeInSlideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fadeInSlideUp {
            animation: fadeInSlideUp 1s ease-out forwards;
        }

        /* Keyframe for icon animation */
        @keyframes bounceIn {
            0% { transform: scale(0.5); opacity: 0; }
            70% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(1); }
        }

        .animate-bounceIn {
            animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Gradient Shift for body background */
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }

        /* Sidebar item hover effect */
        .sidebar li:hover::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(-100%);
            transition: transform 0.4s ease-out;
            z-index: -1;
        }

        .sidebar li:hover::before {
            transform: translateX(0);
        }

        /* Instruction content fade-in animation */
        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }
        }

        .instruction-content.show {
            animation: fadeInScale 0.5s ease-out forwards;
        }

        /* Particle animation */
        @keyframes floatParticles {
            0% { transform: translate(0, 0) rotate(0deg); opacity: 0.5; }
            50% { transform: translate(50px, -50px) rotate(180deg); opacity: 0.7; }
            100% { transform: translate(0, 0) rotate(360deg); opacity: 0.5; }
        }

        .particle {
            position: absolute;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: floatParticles 20s infinite ease-in-out alternate;
            z-index: -1;
        }

        /* New Code Rain animation */
        @keyframes codeRain {
            0% { transform: translateY(-100vh) translateX(0); opacity: 0; }
            5% { opacity: 0.05; } /* Faint start */
            95% { opacity: 0.05; } /* Faint throughout */
            100% { transform: translateY(100vh) translateX(0); opacity: 0; }
        }

        .code-char {
            position: absolute;
            font-family: 'monospace'; /* Monospace font for code */
            font-size: 1.2rem; /* Slightly larger for visibility */
            color: rgba(0, 255, 0, 0.1); /* Very faint green for matrix effect */
            pointer-events: none; /* Don't interfere with clicks */
            user-select: none; /* Don't allow selection */
            animation: codeRain linear infinite;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row items-center justify-center min-h-screen p-6 relative">

    <div class="background-pattern"></div>
    <div class="absolute top-1/4 left-1/4 w-32 h-32 bg-indigo-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-4000"></div>
    <div class="absolute bottom-1/4 right-1/4 w-48 h-48 bg-sky-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-1000"></div>
    <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-2000"></div>
    <div class="absolute top-1/2 left-1/2 w-56 h-56 bg-cyan-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-6000"></div>
    <div class="absolute bottom-0 left-1/3 w-24 h-24 bg-purple-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-3000"></div>
    <div class="absolute top-1/3 right-0 w-36 h-36 bg-teal-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-5000"></div>

    <div class="particle w-2 h-2 top-10 left-20" style="animation-delay: 0s; animation-duration: 25s;"></div>
    <div class="particle w-3 h-3 bottom-20 right-30" style="animation-delay: 5s; animation-duration: 20s;"></div>
    <div class="particle w-2 h-2 top-1/2 left-1/4" style="animation-delay: 10s; animation-duration: 30s;"></div>
    <div class="particle w-4 h-4 bottom-1/3 left-10" style="animation-delay: 15s; animation-duration: 18s;"></div>
    <div class="particle w-3 h-3 top-5 right-50" style="animation-delay: 2s; animation-duration: 22s;"></div>

    <div class="code-rain-container absolute inset-0 overflow-hidden z-0">
        <span class="code-char" style="left: 10%; animation-duration: 15s; animation-delay: 0s;">int</span>
        <span class="code-char" style="left: 25%; animation-duration: 18s; animation-delay: 2s;">{}</span>
        <span class="code-char" style="left: 40%; animation-duration: 13s; animation-delay: 1s;">void</span>
        <span class="code-char" style="left: 55%; animation-duration: 16s; animation-delay: 3s;">;</span>
        <span class="code-char" style="left: 70%; animation-duration: 14s; animation-delay: 0.5s;">char</span>
        <span class="code-char" style="left: 85%; animation-duration: 17s; animation-delay: 4s;">()</span>
        <span class="code-char" style="left: 5%; animation-duration: 19s; animation-delay: 2.5s;">01</span>
        <span class="code-char" style="left: 20%; animation-duration: 12s; animation-delay: 1.5s;">*</span>
        <span class="code-char" style="left: 35%; animation-duration: 20s; animation-delay: 5s;">&</span>
        <span class="code-char" style="left: 60%; animation-duration: 14.5s; animation-delay: 0s;">if</span>
        <span class="code-char" style="left: 75%; animation-duration: 16.5s; animation-delay: 3.5s;">else</span>
        <span class="code-char" style="left: 90%; animation-duration: 13.5s; animation-delay: 1s;">for</span>
    </div>

    <div class="sidebar w-full md:w-72 bg-gray-900 bg-opacity-80 backdrop-blur-sm p-8 rounded-2xl shadow-3xl overflow-y-auto mb-6 md:mb-0 md:mr-8
                 transform hover:scale-[1.01] transition-transform duration-300 ease-in-out border border-gray-700 z-10">
        <h2 class="text-3xl font-extrabold text-blue-400 mb-6 border-b-2 pb-4 border-blue-600 text-shadow-sm">Instructions</h2>
        <ul class="list-none space-y-4">
            <li onclick="handleInstruction('levels')" class="flex items-center space-x-3 text-gray-200 text-lg font-medium cursor-pointer p-3 rounded-xl hover:bg-blue-700 hover:text-white transition-all duration-300 relative overflow-hidden group">
                <i class="ph-fill ph-list-numbers text-2xl text-blue-300 group-hover:text-white transition-colors"></i>
                <span>Levels</span>
            </li>
            <li onclick="handleInstruction('movement')" class="flex items-center space-x-3 text-gray-200 text-lg font-medium cursor-pointer p-3 rounded-xl hover:bg-blue-700 hover:text-white transition-all duration-300 relative overflow-hidden group">
                <i class="ph-fill ph-arrows-out-line-horizontal text-2xl text-blue-300 group-hover:text-white transition-colors"></i>
                <span>Movement</span>
            </li>
            <li onclick="handleInstruction('materials')" class="flex items-center space-x-3 text-gray-200 text-lg font-medium cursor-pointer p-3 rounded-xl hover:bg-blue-700 hover:text-white transition-all duration-300 relative overflow-hidden group">
                <i class="ph-fill ph-cube text-2xl text-blue-300 group-hover:text-white transition-colors"></i>
                <span>Materials</span>
            </li>
            <li onclick="handleInstruction('quiz')" class="flex items-center space-x-3 text-gray-200 text-lg font-medium cursor-pointer p-3 rounded-xl hover:bg-blue-700 hover:text-white transition-all duration-300 relative overflow-hidden group">
                <i class="ph-fill ph-question text-2xl text-blue-300 group-hover:text-white transition-colors"></i>
                <span>Quiz</span>
            </li>
        </ul>
    </div>

    <div class="main-content flex-1 flex flex-col items-center justify-center p-8 relative w-full md:min-w-[400px]">
        <div class="top-right absolute top-6 right-6 flex space-x-4 z-20">
            <button onclick="window.location.href='/login'" class="bg-blue-600 text-white py-2 px-6 rounded-full font-semibold hover:bg-blue-700 transition-colors duration-200 shadow-lg transform hover:-translate-y-1">
                Login
            </button>
            <button onclick="window.location.href='/signup'" class="bg-purple-600 text-white py-2 px-6 rounded-full font-semibold hover:bg-purple-700 transition-colors duration-200 shadow-lg transform hover:-translate-y-1">
                Sign Up
            </button>
        </div>

        <h1 id="mainTitle" class="text-6xl font-extrabold text-white text-shadow-lg mb-12 animate-fadeInSlideUp" style="text-shadow: 0 0 15px rgba(255,255,255,0.5);">Welcome to StudyUp</h1>

        <div id="movementContent" class="instruction-content hidden bg-gray-900 bg-opacity-80 backdrop-blur-sm p-10 rounded-2xl shadow-3xl w-full max-w-3xl absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 overflow-y-auto max-h-[90vh] border border-gray-700 z-10">
            <h2 class="text-4xl font-extrabold text-blue-300 mb-8">Arrow Key Definitions</h2>
            <div class="arrow flex items-center p-5 rounded-xl bg-gray-800 mb-4 shadow-md hover:shadow-xl hover:scale-[1.02] transition-all duration-300 border border-gray-700">
                <div class="arrow-icon text-5xl text-blue-400 mr-5 w-14 text-center flex-shrink-0">↑</div>
                <div class="arrow-description text-gray-300 text-lg text-left"><strong>Up Arrow (↑):</strong> Move upward or advance forward.</div>
            </div>
            <div class="arrow flex items-center p-5 rounded-xl bg-gray-800 mb-4 shadow-md hover:shadow-xl hover:scale-[1.02] transition-all duration-300 border border-gray-700">
                <div class="arrow-icon text-5xl text-blue-400 mr-5 w-14 text-center flex-shrink-0">←</div>
                <div class="arrow-description text-gray-300 text-lg text-left"><strong>Left Arrow (←):</strong> Move left or turn left.</div>
            </div>
            <div class="arrow flex items-center p-5 rounded-xl bg-gray-800 mb-4 shadow-md hover:shadow-xl hover:scale-[1.02] transition-all duration-300 border border-gray-700">
                <div class="arrow-icon text-5xl text-blue-400 mr-5 w-14 text-center flex-shrink-0">↓</div>
                <div class="arrow-description text-gray-300 text-lg text-left"><strong>Down Arrow (↓):</strong> Move downward or retreat.</div>
            </div>
            <div class="arrow flex items-center p-5 rounded-xl bg-gray-800 mb-4 shadow-md hover:shadow-xl hover:scale-[1.02] transition-all duration-300 border border-gray-700">
                <div class="arrow-icon text-5xl text-blue-400 mr-5 w-14 text-center flex-shrink-0">→</div>
                <div class="arrow-description text-gray-300 text-lg text-left"><strong>Right Arrow (→):</strong> Move right or turn right.</div>
            </div>
        </div>

        <div id="levelsContent" class="instruction-content hidden bg-gray-900 bg-opacity-80 backdrop-blur-sm p-10 rounded-2xl shadow-3xl w-full max-w-3xl absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 overflow-y-auto max-h-[90vh] border border-gray-700 z-10">
            <h2 class="text-4xl font-extrabold text-blue-300 mb-8">Game Levels</h2>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 1: Introduction to C</h3>
                <p class="text-gray-400 text-base leading-relaxed">Learn about printf() and scanf(), the basic structure of a C program, and how to write and run your first "Hello, World!" program.</p>
            </div>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 2: Variables and Data Types</h3>
                <p class="text-gray-400 text-base leading-relaxed">Understand how to declare variables and use data types such as int, float, char, and double to store and display values.</p>
            </div>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 3: Operators and Expressions</h3>
                <p class="text-gray-400 text-base leading-relaxed">Explore arithmetic, assignment, relational, and logical operators to perform calculations and build meaningful expressions.</p>
            </div>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 4: Conditional Statements</h3>
                <p class="text-gray-400 text-base leading-relaxed">Learn how to use if, else if, else, and switch statements to make decisions in your C programs.</p>
            </div>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 5: Loops and Control Statements</h3>
                <p class="text-gray-400 text-base leading-relaxed">Use for, while, and do...while loops, along with control statements like break and continue, to manage repetition and control flow.</p>
            </div>
            <div class="level-item pb-6 mb-6 border-b border-gray-700 last:border-b-0 text-left">
                <h3 class="text-2xl font-semibold text-blue-300 mb-2">Level 6: Functions in C</h3>
                <p class="text-gray-400 text-base leading-relaxed">Discover how to define and call functions, pass parameters, and return values to organize your program into reusable parts.</p>
            </div>
        </div>

        <div id="materialsContent" class="instruction-content hidden bg-gray-900 bg-opacity-80 backdrop-blur-sm p-10 rounded-2xl shadow-3xl w-full max-w-3xl absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 overflow-y-auto max-h-[90vh] border border-gray-700 z-10">
            <h2 class="text-4xl font-extrabold text-blue-300 mb-8">Materials</h2>
            <img src="https://i.postimg.cc/GHgVdbyh/Screenshot-2025-05-26-222519.png" alt="Materials Image" class="instruction-image max-w-full h-auto rounded-lg mb-6 shadow-md hover:scale-[1.03] transition-transform duration-300">
            <p class="instruction-description text-gray-300 text-lg leading-relaxed">
                Find and collect material boxes hidden in each level to unlock key C programming concepts. Each one helps you progress by explaining core topics interactively.
            </p>
        </div>

        <div id="quizContent" class="instruction-content hidden bg-gray-900 bg-opacity-80 backdrop-blur-sm p-10 rounded-2xl shadow-3xl w-full max-w-3xl absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 overflow-y-auto max-h-[90vh] border border-gray-700 z-10">
            <h2 class="text-4xl font-extrabold text-blue-300 mb-8">Quiz</h2>
            <img src="https://i.postimg.cc/jwTkZ5Gv/Screenshot-2025-05-26-222606.png" alt="Quiz Image" class="instruction-image max-w-full h-auto rounded-lg mb-6 shadow-md hover:scale-[1.03] transition-transform duration-300">
            <p class="instruction-description text-gray-300 text-lg leading-relaxed">
                Collect quiz boxes during the game to test what you've learned. Answer questions correctly to earn points and track your C programming progress.
            </p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Function to generate and append code characters
            function createCodeRain() {
                const container = document.querySelector('.code-rain-container');
                const characters = ['int', 'void', 'char', 'if', 'else', 'for', 'while', '{', '}', '(', ')', '[', ']', ';', '*', '&', '0', '1'];
                const numChars = 50; // Number of characters to generate

                for (let i = 0; i < numChars; i++) {
                    const char = document.createElement('span');
                    char.classList.add('code-char');
                    char.textContent = characters[Math.floor(Math.random() * characters.length)];
                    char.style.left = `${Math.random() * 100}%`;
                    char.style.animationDuration = `${Math.random() * 10 + 10}s`; // 10-20s duration
                    char.style.animationDelay = `${Math.random() * 10}s`; // 0-10s delay
                    container.appendChild(char);
                }
            }

            createCodeRain(); // Call on page load

            // Existing instruction handling logic
            function handleInstruction(type) {
                const mainTitle = document.getElementById('mainTitle');
                const instructionContents = document.querySelectorAll('.instruction-content');

                // Hide main title
                mainTitle.classList.add('hidden');

                // Hide all instruction content containers and remove 'show' class
                instructionContents.forEach(content => {
                    content.classList.add('hidden');
                    content.classList.remove('show');
                });

                // Show the selected content and add 'show' class for animation
                const selectedContent = document.getElementById(`${type}Content`);
                if (selectedContent) {
                    selectedContent.classList.remove('hidden');
                    selectedContent.classList.add('show');
                }
            }

            // Expose handleInstruction to the global scope for onclick attributes
            window.handleInstruction = handleInstruction;
        });
    </script>
</body>
</html>